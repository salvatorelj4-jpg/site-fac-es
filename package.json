{
  "name": "stalker-faction-network",
  "version": "2.7.3",
  "description": "Multi-faction management system inspired by S.T.A.L.K.E.R.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:oblivion": "node --test tests/sftp-agent.test.mjs tests/oblivion-v171.test.js",
    "test:skad-migration": "node --test tests/skad-migration.test.mjs",
    "test:runtime-status": "node --test tests/runtime-status.test.cjs",
    "test:sftp-dry-run": "node --test tests/sftp-dry-run-runner.test.mjs",
    "test:sftp-diagnostics": "node --test tests/sftp-dry-run-diagnostics.test.mjs",
    "test:sftp-405-diagnostic": "node --test tests/sftp-405-diagnostic.test.mjs",
    "test:sftp-http-diagnostic": "node --test tests/sftp-405-diagnostic.test.mjs",
    "test:neutral-connection-check": "node --test tests/neutral-connection-check.test.mjs",
    "test:admin-sftp-dry-run": "node --test tests/admin-sftp-dry-run.test.mjs",
    "test:sftp-ui-diagnostics": "node --test tests/sftp-ui-diagnostics.test.mjs",
    "obc:sftp:dry-run": "node bridge/run-sftp-dry-run.mjs",
    "seed": "node scripts/seed.js",
    "start:prod": "NODE_ENV=production node server.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "ssh2-sftp-client": "^11.0.0",
    "multer": "^2.3.0",
    "sqlite3": "^6.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.67"
  },
  "allowScripts": {
    "sqlite3": true
  },
  "author": "Faction Network",
  "license": "ISC",
  "engines": {
    "node": ">=20 <25"
  }
}
